rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function estaLogado() {
      return request.auth != null;
    }

    function dadosDoUsuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function ehAdministrador() {
      return estaLogado() && dadosDoUsuario().papel == 'administrador';
    }

    function podeEditar() {
      return estaLogado() &&
        (dadosDoUsuario().papel == 'administrador' || dadosDoUsuario().papel == 'cadastrador');
    }

    function temAcessoEntidade(entidadeId) {
      return ehAdministrador() ||
        (entidadeId in dadosDoUsuario().unidadesGestoras);
    }

    // ---------- USUÁRIOS ----------
    // Cada usuário só pode ler o próprio documento; só administrador
    // pode criar/editar/excluir usuários (inclusive o próprio).
    match /usuarios/{usuarioId} {
      allow read: if estaLogado() && (request.auth.uid == usuarioId || ehAdministrador());
      allow write: if ehAdministrador();
    }

    // ---------- UNIDADES GESTORAS ----------
    match /entidades/{entidadeId} {
      allow read: if temAcessoEntidade(entidadeId);
      // Atualização de "pastasDrive" pode ser feita por quem edita
      // (é gerada automaticamente ao enviar o primeiro anexo).
      allow update: if podeEditar() && temAcessoEntidade(entidadeId);
      allow create, delete: if ehAdministrador();

      // Subcoleção "config" guarda dados sensíveis (ex: refresh token do
      // Drive) — só administrador pode ler ou escrever, mesmo que outros
      // usuários tenham acesso normal à unidade gestora. Como essa regra
      // é mais específica que a wildcard "{colecao}" logo abaixo, ela
      // tem prioridade sobre ela para esse caminho.
      match /config/{documentoId} {
        allow read, write: if ehAdministrador();
      }

      // Subcoleção "historico" é o registro de auditoria — só
      // administrador pode ler (é informação sobre o trabalho de todo
      // mundo), quem edita pode criar linhas novas (é assim que o
      // histórico é gravado, automaticamente a cada ação), e ninguém
      // pode editar ou apagar uma linha já gravada.
      match /historico/{documentoId} {
        allow read: if ehAdministrador();
        allow create: if podeEditar() && temAcessoEntidade(entidadeId);
        allow update, delete: if false;
      }

      // ---------- SUBCOLEÇÕES DE CADA UNIDADE GESTORA ----------
      match /{colecao}/{documentoId} {
        allow read: if temAcessoEntidade(entidadeId);
        allow create, update: if podeEditar() && temAcessoEntidade(entidadeId);
        allow delete: if podeEditar() && temAcessoEntidade(entidadeId);
      }
    }
  }
}
